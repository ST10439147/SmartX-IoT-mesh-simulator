@using SmartX.Shared.Topology
@*
    Renders the deployment hierarchy by recursing on itself - the component calls
    <TopologyTree> for each child, so an arbitrarily deep tree needs no extra markup.
    Depth is carried down and capped for the same reason the server-side validator caps
    it: a malformed tree must not take the renderer with it.
*@

<ul class="tree">
    @foreach (var child in Node.Children)
    {
        <li>
            <span class="tag @KindClass(child.Kind)">@Label(child.Kind)</span>
            <span class="tree-name">@child.Name</span>
            @if (!string.IsNullOrWhiteSpace(child.SensorId))
            {
                <span class="meta">@child.SensorId</span>
            }

            @if (child.Children.Count > 0 && Depth < MaxRenderDepth)
            {
                <TopologyTree Node="child" Depth="Depth + 1" />
            }
            else if (child.Children.Count > 0)
            {
                <span class="meta">+@child.Children.Count more, collapsed at render depth @MaxRenderDepth</span>
            }
        </li>
    }
</ul>

@code {
    private const int MaxRenderDepth = 12;

    [Parameter, EditorRequired] 
    public DeploymentNode Node { get; set; } = default!;

    [Parameter] public int Depth { get; set; }

    private static string Label(NodeKind kind) => kind == NodeKind.SubZone ? "sub-zone" : kind.ToString().ToLowerInvariant();

    private static string KindClass(NodeKind kind) => kind switch
    {
        NodeKind.Facility => "ok",
        NodeKind.Zone => "info",
        NodeKind.SubZone => "",
        _ => "warn"
    };
}
