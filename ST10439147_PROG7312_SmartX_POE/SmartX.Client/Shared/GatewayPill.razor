@implements IDisposable
@inject Services.GatewayClient Gateway

@*
    Persistent link indicator. The brief's failure mode for this row is a client that
    silently stops talking to the API, so the connection state is always on screen with
    a real measured round-trip rather than a hard-coded "connected".
*@

<div class="link-state" title="@_detail">
    <span class="dot @_dotClass"></span>
    <span>@_label</span>
</div>

@code {
    private static readonly TimeSpan Interval = TimeSpan.FromSeconds(10);

    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;

    private string _label = "connecting";
    private string _dotClass = "wait";
    private string _detail = "Contacting the gateway API...";

    protected override async Task OnInitializedAsync()
    {
        await PingAsync();

        _timer = new PeriodicTimer(Interval);
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await PingAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed; nothing to clean up beyond the token.
        }
    }

    private async Task PingAsync()
    {
        var (status, ms, error) = await Gateway.PingAsync(_cts.Token);

        if (status is null)
        {
            _label = "gateway offline";
            _dotClass = "down";
            _detail = error ?? "No response from the gateway API.";
            return;
        }

        _label = $"{ms} ms";
        _dotClass = "live";
        _detail = $"{Gateway.BaseAddress} - {status.SensorsRegistered} nodes, "
                + $"{status.PacketsPerSecond:0.0} packets/s, up {TimeSpan.FromSeconds(status.UptimeSeconds):hh\\:mm\\:ss}";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _cts.Dispose();
    }
}
