@inject IJSRuntime JS

@*
    Light / dark switch. The palette lives entirely in CSS variables keyed off
    <html data-theme>; this component flips that attribute (via the helper in
    index.html) and lets the helper persist the choice to localStorage.
    The toggle reads the live DOM state, so it stays correct even if this
    component's cached _theme is momentarily stale.
*@

<button class="theme-toggle" type="button" @onclick="Toggle"
        title="Switch between light and dark theme"
        aria-label="Switch between light and dark theme">
    @(_theme == "light" ? "☀" : "☽")
</button>

@code {
    private string _theme = "dark";

    // Standalone WASM has no prerender, so JS interop is available here - runs
    // once before the first render, no post-render StateHasChanged to swap the
    // button out from under the user's first click.
    protected override async Task OnInitializedAsync()
        => _theme = await JS.InvokeAsync<string>("smartXTheme.get");

    private async Task Toggle()
        => _theme = await JS.InvokeAsync<string>("smartXTheme.toggle");
}
