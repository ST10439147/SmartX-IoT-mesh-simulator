@page "/dashboard"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable
@inject GatewayClient Gateway

<PageTitle>Live dashboard - Smart-X Gateway</PageTitle>

<div class="page-head">
    <h1>Anomaly-first telemetry console</h1>
    <p>
        Deviation gets colour and position; everything behaving normally is drawn in one muted hue.
        Packets arrive over a push connection rather than a poll, so a two-second spike is visible
        instead of being averaged away by a refresh interval.
    </p>
</div>

@if (_status is not null)
{
    <div class="stats" style="margin-bottom:1rem">
        <div class="stat">
            <div class="label">Connection</div>
            <div class="value @(_connected ? "ok" : "crit")" style="font-size:1rem">@_connectionLabel</div>
        </div>
        <div class="stat">
            <div class="label">Nodes</div>
            <div class="value">@_status.SensorsRegistered</div>
        </div>
        <div class="stat">
            <div class="label">Silent</div>
            <div class="value @(_status.SensorsSilent > 0 ? "warn" : "ok")">@_status.SensorsSilent</div>
        </div>
        <div class="stat">
            <div class="label">Throughput</div>
            <div class="value">@_status.PacketsPerSecond.ToString("0.0")/s</div>
        </div>
        <div class="stat">
            <div class="label">Open alerts</div>
            <div class="value @(_status.ActiveAlerts > 0 ? "crit" : "ok")">@_status.ActiveAlerts</div>
        </div>
        <div class="stat">
            <div class="label">Suppressed</div>
            <div class="value">@_status.SuppressedAlerts</div>
        </div>
    </div>
}

<div class="dash">

    @* ------------------------------------------------------------ severity-ranked rail *@
    <section class="panel">
        <div class="panel-head">
            <h2>Alert rail</h2>
            <span class="count">@_active.Count open</span>
        </div>

        <div class="rail">
            @if (_active.Count == 0)
            {
                <div class="empty-rail">
                    <div>
                        <div style="font-size:1.6rem">&#9678;</div>
                        Nothing needs attention.<br />
                        <span class="hint">Spikes and disconnects appear here, worst first.</span>
                    </div>
                </div>
            }

            @foreach (var alert in _active)
            {
                <button class="alert @SeverityClass(alert.Severity) @(alert.Id == _selectedAlert?.Id ? "sel" : "")"
                        @onclick="() => SelectAlert(alert)">
                    <div class="row">
                        <span class="tag @SeverityClass(alert.Severity)">@alert.Kind</span>
                        <span class="who">@alert.SensorName</span>
                        <span class="when">@Ago(alert.RaisedAt)</span>
                    </div>
                    <div class="what">@alert.Message</div>
                </button>
            }

            @if (_suppressed.Count > 0)
            {
                <details class="suppressed-group">
                    <summary>
                        @_suppressed.Count suppressed alert(s); repeatedly dismissed, kept for audit
                    </summary>
                    <div class="list-inner">
                        @foreach (var alert in _suppressed)
                        {
                            <button class="alert" @onclick="() => SelectAlert(alert)">
                                <div class="row">
                                    <span class="tag">@alert.Kind</span>
                                    <span class="who">@alert.SensorName</span>
                                    <span class="when">@Ago(alert.RaisedAt)</span>
                                </div>
                                <div class="what">@alert.Message</div>
                            </button>
                        }
                    </div>
                </details>
            }
        </div>
    </section>

    @* ------------------------------------------------------------ small-multiple grid *@
    <section class="panel">
        <div class="panel-head">
            <h2>Mesh</h2>
            <span class="count">@_snapshots.Count nodes &middot; shared scale per tile</span>
        </div>

        <div class="sensor-grid">
            @foreach (var sensor in _snapshots)
            {
                <button class="tile @TileClass(sensor)" @onclick="() => SelectSensor(sensor)">
                    <div class="name">@sensor.DisplayName</div>
                    <div class="path">@sensor.DeploymentPath</div>
                    <div class="reading">
                        @Reading(sensor)<span class="unit">@sensor.Unit</span>
                    </div>
                    <Sparkline Values="sensor.Spark"
                               Stroke="@(Flagged(sensor) ? "var(--crit)" : "var(--normal)")"
                               Label="@($"{sensor.DisplayName} recent readings")" />
                </button>
            }
        </div>
    </section>
</div>

@* ------------------------------------------------------------ drill-down inspector *@
@if (_selectedSensor is not null)
{
    <section class="panel inspector">
        <div class="panel-head">
            <h2>Inspector ; @_selectedSensor.DisplayName</h2>
            @if (_selectedAlert is not null)
            {
                <span class="tag @SeverityClass(_selectedAlert.Severity)">@_selectedAlert.Severity</span>
            }
            <span class="count">@_selectedSensor.MacAddress</span>
        </div>

        <div class="split">
            <div>
                <dl class="kv">
                    <dt>Deployment</dt><dd>@_selectedSensor.DeploymentPath</dd>
                    <dt>Category</dt><dd>@_selectedSensor.Category.Spec().Label</dd>
                    <dt>Payload</dt><dd>TelemetryPacket&lt;@PayloadType(_selectedSensor.Payload)&gt;</dd>
                    <dt>Latest</dt><dd>@Reading(_selectedSensor)@_selectedSensor.Unit</dd>
                    <dt>Baseline</dt><dd>@_selectedSensor.Baseline.ToString("0.##")@_selectedSensor.Unit</dd>
                    <dt>Packets</dt><dd>@_selectedSensor.PacketsReceived.ToString("N0")</dd>
                    <dt>Last seen</dt><dd>@(_selectedSensor.LastSeen is null ? "never" : Ago(_selectedSensor.LastSeen.Value))</dd>

                    @if (_selectedAlert is not null)
                    {
                        <dt>Rule fired</dt><dd>@_selectedAlert.Rule</dd>
                        <dt>Expected</dt><dd>@_selectedAlert.Baseline.ToString("0.##")</dd>
                        <dt>Observed</dt><dd>@_selectedAlert.Observed.ToString("0.##")</dd>
                        <dt>Deviation</dt><dd>@_selectedAlert.Deviation.ToString("0.##")</dd>
                    }
                </dl>

                @if (_selectedAlert is not null)
                {
                    <div class="actions">
                        <button class="danger" @onclick="() => DismissAsync(_selectedAlert)">Dismiss this alert</button>
                        <button class="ghost" @onclick="() => RestoreAsync(_selectedAlert)">Un-suppress this kind</button>
                    </div>
                    <p class="hint" style="margin-top:.4rem">
                        Dismissing @AnomalyDismissalsToSuppress times suppresses this kind for this node.
                        Suppressed alerts still fire ; they collapse into the audit group rather than disappearing.
                    </p>
                }
            </div>

            <div>
                <h3>Packets around the event</h3>
                @if (_selectedAlert is { Context.Count: > 0 })
                {
                    <div class="scroll-x">
                        <table class="context-table">
                            <thead>
                                <tr><th>timestamp</th><th>value</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var sample in _selectedAlert.Context)
                                {
                                    <tr class="@(sample.IsOffending ? "offending" : "")">
                                        <td>@sample.At.ToLocalTime().ToString("HH:mm:ss.fff")</td>
                                        <td>@sample.Value.ToString("0.###")</td>
                                        <td>@(sample.IsOffending ? "offending" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="hint">Select an alert from the rail to see the packets either side of it.</p>
                }
            </div>
        </div>

        <div class="attachments-block">
            <h3>Attached files</h3>
            @if (_selectedAttachments.Count == 0)
            {
                <p class="hint">No config files, logs or photos attached to this node. Add one on the Ingestion page.</p>
            }
            else
            {
                <ul class="list">
                    @foreach (var attachment in _selectedAttachments)
                    {
                        <li>
                            <span class="tag ok">@attachment.DetectedType</span>
                            <span class="grow">@attachment.FileName</span>
                            <span class="meta">@Bytes(attachment.PlaintextBytes) &middot; @Ago(attachment.UploadedAt)</span>
                            <a href="@Gateway.DownloadUrl(attachment)" target="_blank" rel="noopener">
                                <button class="tiny">Download</button>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
}

@* ------------------------------------------------------------ device registry *@
<section class="panel inspector">
    <div class="panel-head">
        <h2>Device registry</h2>
        <span class="count">Dictionary&lt;MAC, device&gt; &middot; one hash lookup per packet</span>
    </div>

    <p>
        Every packet names the node that sent it, and the gateway finds that node in a dictionary
        keyed by MAC address. The lookup costs the same whether the mesh has twelve nodes or twelve
        thousand. Type a MAC in any spelling to look a device up the same way a packet does.
    </p>

    @if (_registry is not null)
    {
        <div class="stats">
            <div class="stat">
                <div class="label">Devices</div>
                <div class="value">@_registry.Devices</div>
            </div>
            <div class="stat">
                <div class="label">Lookups</div>
                <div class="value">@_registry.Lookups.ToString("N0")</div>
            </div>
            <div class="stat">
                <div class="label">Misses</div>
                <div class="value @(_registry.Misses > 0 ? "warn" : "ok")">@_registry.Misses.ToString("N0")</div>
            </div>
        </div>
    }

    <div class="form-grid" style="margin-top:.8rem">
        <div class="field">
            <label for="registry-key">MAC address or id</label>
            <input id="registry-key" @bind="_registryKey" placeholder="a4-cf-12-9b-04-7e" />
        </div>
    </div>

    <div class="actions">
        <button @onclick="LookupAsync" disabled="@string.IsNullOrWhiteSpace(_registryKey)">Look up</button>
    </div>

    @if (_registryHit is not null)
    {
        <p class="hint" style="margin-top:.5rem">
            Found <code>@_registryHit.Id</code>: @_registryHit.DisplayName, @_registryHit.DeploymentPath.
        </p>
    }
    else if (_registryMissed)
    {
        <p class="hint" style="margin-top:.5rem">No device is registered under that MAC. The miss has been counted.</p>
    }
</section>

@* ------------------------------------------------------------ timeline *@
<section class="panel inspector">
    <div class="panel-head">
        <h2>Sensor timeline</h2>
        <span class="count">SortedDictionary&lt;DateTimeOffset, reading&gt; &middot; ordered by timestamp</span>
    </div>

    <p>
        A mesh relays packets over several hops, so they do not always arrive in the order they were
        sent. Each sensor's log is kept sorted by the time a reading was taken, so a late packet is
        slotted into its place rather than tacked on the end. Send some out of order to see it.
    </p>

    <div class="form-grid">
        <div class="field">
            <label for="timeline-sensor">Sensor</label>
            <select id="timeline-sensor" value="@_timelineSensor" @onchange="OnTimelineSensorChanged">
                @foreach (var sensor in _snapshots)
                {
                    <option value="@sensor.Id">@sensor.DisplayName</option>
                }
            </select>
        </div>
    </div>

    <div class="actions">
        <button @onclick="ScrambleAsync" disabled="@(_timelineSensor.Length == 0)">Send 8 packets out of order</button>
    </div>

    <TimelineGraph Points="_timeline" Label="@($"{SensorName(_timelineSensor)} readings over time")" />

    @if (_timeline.Count > 0)
    {
        var late = TimelineGraph.LateFlags(_timeline);

        <p class="hint" style="margin-top:.6rem">
            @late.Count(l => l) of the @_timeline.Count readings shown arrived late. They are marked
            on the graph and highlighted below, each in its place in time.
        </p>

        <h3>Readings, newest first</h3>
        <div class="scroll-x" style="max-height:20rem;overflow-y:auto">
            <table class="context-table">
                <thead>
                    <tr><th>taken at</th><th>value</th><th>arrived</th><th></th></tr>
                </thead>
                <tbody>
                    @for (var i = _timeline.Count - 1; i >= 0; i--)
                    {
                        <tr class="@(late[i] ? "offending" : "")">
                            <td>@_timeline[i].At.ToLocalTime().ToString("HH:mm:ss.fff")</td>
                            <td>@_timeline[i].Value.ToString("0.##")</td>
                            <td>#@_timeline[i].Sequence</td>
                            <td>@(late[i] ? "late" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@* ------------------------------------------------------------ disconnect set *@
<section class="panel inspector">
    <div class="panel-head">
        <h2>Disconnect set</h2>
        <span class="count">HashSet&lt;string&gt; &middot; Add returns false for a duplicate</span>
    </div>

    <p>
        A node that stays silent fails the silence check every few seconds, and each failure would
        be another alert. The gateway keeps the silent nodes in a hash set: a node is added when it
        is first found silent, and a repeat finding is recognised as a duplicate and skipped. Open
        spikes and threshold breaches are tracked the same way. Unplug a node and watch the rail.
    </p>

    @if (_faults is not null)
    {
        <div class="stats">
            <div class="stat">
                <div class="label">Disconnected nodes</div>
                <div class="value @(_faults.Disconnected.Count > 0 ? "warn" : "ok")">@_faults.Disconnected.Count</div>
            </div>
            <div class="stat">
                <div class="label">Open error states</div>
                <div class="value @(_faults.ActiveErrors.Count > 0 ? "warn" : "ok")">@_faults.ActiveErrors.Count</div>
            </div>
            <div class="stat">
                <div class="label">Duplicate alerts skipped</div>
                <div class="value">@_faults.DuplicatesSkipped.ToString("N0")</div>
            </div>
        </div>
    }

    <div class="form-grid" style="margin-top:.8rem">
        <div class="field">
            <label for="unplug-sensor">Node</label>
            <select id="unplug-sensor" value="@_unplugSensor" @onchange="e => _unplugSensor = e.Value?.ToString() ?? string.Empty">
                @foreach (var sensor in _snapshots)
                {
                    <option value="@sensor.Id">@sensor.DisplayName</option>
                }
            </select>
        </div>
    </div>

    <div class="actions">
        <button class="danger" @onclick="() => UnplugAsync(60)" disabled="@(_unplugSensor.Length == 0)">Unplug for 60 s</button>
        <button @onclick="() => UnplugAsync(0)" disabled="@(_unplugSensor.Length == 0)">Plug back in</button>
    </div>
    <p class="hint" style="margin-top:.4rem">
        The node is found silent after three missed publish intervals, checked every five seconds.
    </p>

    @if (_faults is not null)
    {
        <div class="split">
            <div>
                <h3>In the disconnect set</h3>
                @if (_faults.Disconnected.Count == 0)
                {
                    <p class="hint">Empty. Every node is reporting.</p>
                }
                else
                {
                    <ul class="list">
                        @foreach (var id in _faults.Disconnected)
                        {
                            <li>
                                <span class="tag warn">Silence</span>
                                <span class="grow">@SensorName(id)</span>
                                <span class="meta">@_active.Concat(_suppressed).Count(a => a.SensorId == id && a.Kind == AlertKind.Silence) alert(s)</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div>
                <h3>Open error states</h3>
                @if (_faults.ActiveErrors.Count == 0)
                {
                    <p class="hint">Empty. No spike or threshold breach is in progress.</p>
                }
                else
                {
                    <ul class="list">
                        @foreach (var key in _faults.ActiveErrors)
                        {
                            var parts = key.Split('|');

                            <li>
                                <span class="tag warn">@parts[^1]</span>
                                <span class="grow">@SensorName(parts[0])</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</section>

@* ------------------------------------------------------------ manual override commands *@
<section class="panel inspector">
    <div class="panel-head">
        <h2>Manual override</h2>
        <span class="count">Stack&lt;T&gt; command history &middot; undo is last in, first out</span>
    </div>

    <p>
        A command pins an actuator on or off until it is undone. Every command is pushed onto a
        stack, and Undo pops the most recent one and puts each device back as it was.
    </p>

    <div class="split">
        <div>
            <h3>Actuators</h3>
            @if (_actuators.Count == 0)
            {
                <p class="hint">No valves or vents registered.</p>
            }
            else
            {
                <ul class="list">
                    @foreach (var device in _actuators)
                    {
                        <li>
                            <span class="tag @(device.LatestBool ? "ok" : "")">@(device.LatestBool ? "OPEN" : "SHUT")</span>
                            <span class="grow">@device.DisplayName</span>
                            <span class="meta">@OverrideLabel(device.Id)</span>
                            <button class="tiny" @onclick="() => CommandAsync(device, true)">On</button>
                            <button class="tiny" @onclick="() => CommandAsync(device, false)">Off</button>
                        </li>
                    }
                </ul>
            }

            <div class="actions">
                <button class="danger" @onclick="ShutAllValvesAsync"
                        disabled="@(!_actuators.Any(a => a.Category == SensorCategory.IrrigationValve))">
                    Shut all valves
                </button>
                <button @onclick="UndoAsync" disabled="@(_commands is not { History.Count: > 0 })">Undo last command</button>
            </div>
            <p class="hint" style="margin-top:.4rem">A device acts on a command the next time it publishes, so allow a few seconds.</p>
        </div>

        <div>
            <h3>Command history, newest first</h3>
            @if (_commands is not { History.Count: > 0 })
            {
                <p class="hint">No commands issued. Nothing to undo.</p>
            }
            else
            {
                <ul class="list">
                    @foreach (var command in _commands.History)
                    {
                        <li>
                            <span class="tag @(command == _commands.History[0] ? "warn" : "")">
                                @(command == _commands.History[0] ? "next undo" : $"#{command.Id}")
                            </span>
                            <span class="grow">@command.Label</span>
                            <span class="meta">@command.Changes.Count device(s) &middot; @Ago(command.IssuedAt)</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</section>

@* ------------------------------------------------------------ ingest queue *@
<section class="panel inspector">
    <div class="panel-head">
        <h2>Ingest queue</h2>
        <span class="count">FIFO Queue&lt;T&gt; &middot; criticals via PriorityQueue</span>
    </div>

    <p>
        Every packet waits here before the background worker ingests it. Normal packets leave in
        arrival order; a spike or threshold breach goes into a priority lane that the worker always
        empties first. Flood the queue, then send a critical packet, to watch it overtake the backlog.
    </p>

    <div class="actions">
        <button @onclick="FloodAsync">Flood the queue</button>
        <button class="danger" @onclick="SendCriticalAsync" disabled="@(CriticalTarget is null)">Send critical packet</button>
    </div>

    @if (_queue is not null)
    {
        <div class="stats" style="margin-top:.8rem">
            <div class="stat">
                <div class="label">Waiting (normal)</div>
                <div class="value @(_queue.Depth > 0 ? "warn" : "ok")">@_queue.Depth</div>
            </div>
            <div class="stat">
                <div class="label">Waiting (critical)</div>
                <div class="value @(_queue.CriticalDepth > 0 ? "crit" : "ok")">@_queue.CriticalDepth</div>
            </div>
            <div class="stat">
                <div class="label">Processed</div>
                <div class="value">@_queue.Processed.ToString("N0")</div>
            </div>
            <div class="stat">
                <div class="label">Worker delay</div>
                <div class="value">@_queue.ThrottleMs.ToString("0") ms</div>
            </div>
        </div>

        @if (_lastCritical is { } jumped)
        {
            <p class="hint" style="margin-top:.6rem">
                Last critical packet (@jumped.Critical on @SensorName(jumped.SensorId)) arrived
                <code>#@jumped.Sequence</code> and was processed <code>#@jumped.Position</code>,
                ahead of @_overtaken older normal packet(s).
            </p>
        }

        <h3>Processing order, newest first</h3>
        <div class="scroll-x" style="max-height:20rem;overflow-y:auto">
            <table class="context-table">
                <thead>
                    <tr><th>processed</th><th>arrived</th><th>lane</th><th>sensor</th><th>value</th><th>waited</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in _queue.Recent.AsEnumerable().Reverse())
                    {
                        <tr class="@(entry.Critical is null ? "" : "offending")">
                            <td>#@entry.Position</td>
                            <td>#@entry.Sequence</td>
                            <td>@(entry.Critical?.ToString() ?? "normal")</td>
                            <td>@SensorName(entry.SensorId)</td>
                            <td>@entry.Value.ToString("0.##")</td>
                            <td>@entry.WaitedMs.ToString("0") ms</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@* ------------------------------------------------------------ operator overloading *@
<section class="panel inspector">
    <div class="panel-head">
        <h2>Aggregate two pump meters</h2>
        <span class="count">Meter3 = Meter1 + Meter2</span>
    </div>

    <p>
        Combined load is computed with an overloaded <code>+</code> on
        <code>SensorReading&lt;T&gt;</code>, and the comparison below with an overloaded
        <code>&gt;</code>. No helper methods, no unwrapping to raw doubles first.
    </p>

    <div class="form-grid">
        <div class="field">
            <label for="meter-a">Meter 1</label>
            <select id="meter-a" value="@_aggregateA" @onchange="e => OnAggregateChanged(e, true)">
                @foreach (var sensor in _meters)
                {
                    <option value="@sensor.Id">@sensor.DisplayName</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="meter-b">Meter 2</label>
            <select id="meter-b" value="@_aggregateB" @onchange="e => OnAggregateChanged(e, false)">
                @foreach (var sensor in _meters)
                {
                    <option value="@sensor.Id">@sensor.DisplayName</option>
                }
            </select>
        </div>
    </div>

    <div class="actions">
        <button @onclick="AggregateAsync" disabled="@(_meters.Count < 2)">Compute</button>
    </div>

    @if (_aggregate is not null)
    {
        <div class="stats" style="margin-top:.8rem">
            <div class="stat">
                <div class="label">@_aggregate.Left.DisplayName</div>
                <div class="value">@_aggregate.Left.Value.ToString("0.##")@_aggregate.Left.Unit</div>
            </div>
            <div class="stat">
                <div class="label">@_aggregate.Right.DisplayName</div>
                <div class="value">@_aggregate.Right.Value.ToString("0.##")@_aggregate.Right.Unit</div>
            </div>
            <div class="stat">
                <div class="label">Combined (a + b)</div>
                <div class="value ok">@_aggregate.Aggregate.Value.ToString("0.##")</div>
            </div>
            <div class="stat">
                <div class="label">Delta (a - b)</div>
                <div class="value">@_aggregate.Delta.Value.ToString("0.##")</div>
            </div>
            <div class="stat">
                <div class="label">a &gt; b</div>
                <div class="value">@(_aggregate.LeftDrawsMore ? "true" : "false")</div>
            </div>
        </div>
        <p class="hint" style="margin-top:.5rem">Composite id from the operator: <code>@_aggregate.Aggregate.Id</code></p>
    }
</section>

@code {
    private const int AnomalyDismissalsToSuppress = 3;

    private HubConnection? _hub;
    private bool _connected;
    private string _connectionLabel = "connecting";

    private IReadOnlyList<SensorSnapshot> _snapshots = [];
    private GatewayStatus? _status;

    private List<Alert> _active = [];
    private List<Alert> _suppressed = [];

    private Alert? _selectedAlert;
    private SensorSnapshot? _selectedSensor;
    private IReadOnlyList<AttachmentInfo> _selectedAttachments = [];

    private List<SensorSnapshot> _meters = [];
    private string _aggregateA = string.Empty;
    private string _aggregateB = string.Empty;
    private AggregateResult? _aggregate;

    private CommandLog? _commands;
    private List<SensorSnapshot> _actuators = [];

    private RegistryStatus? _registry;
    private string _registryKey = string.Empty;
    private SensorSnapshot? _registryHit;
    private bool _registryMissed;

    private string _timelineSensor = string.Empty;
    private IReadOnlyList<TimelinePoint> _timeline = [];

    private FaultState? _faults;
    private string _unplugSensor = string.Empty;

    private QueueStatus? _queue;
    private QueueEntry? _lastCritical;
    private int _overtaken;   // packets that arrived before _lastCritical but were processed after it

    // Reference [22]: Microsoft. Introduction to ASP.NET Core SignalR. Microsoft Learn.
    //   https://learn.microsoft.com/aspnet/core/signalr/introduction
    protected override async Task OnInitializedAsync()
    {
        // Seed from REST so the page is populated before the first push arrives.
        _snapshots = await Gateway.GetSensorsAsync();
        RefreshMeters();
        SortAlerts(await Gateway.GetAlertsAsync());
        await RefreshQueueAsync();
        await RefreshCommandsAsync();
        await RefreshRegistryAsync();
        await RefreshTimelineAsync();
        await RefreshFaultsAsync();

        _hub = new HubConnectionBuilder()
            .WithUrl(new Uri(Gateway.BaseAddress, "hubs/telemetry"))
            .AddJsonProtocol(options => SmartXJson.Configure(options.PayloadSerializerOptions))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<List<SensorSnapshot>, GatewayStatus>(HubEvents.Tick, async (snapshots, status) =>
        {
            _snapshots = snapshots;
            _status = status;
            RefreshMeters();

            // Keep the inspector pinned to the same node as fresh data lands.
            if (_selectedSensor is not null)
                _selectedSensor = snapshots.FirstOrDefault(s => s.Id == _selectedSensor.Id) ?? _selectedSensor;

            // The queue has no push event of its own; the once-a-second tick is the cue to re-read it.
            await RefreshQueueAsync();
            await RefreshCommandsAsync();
            await RefreshRegistryAsync();
            await RefreshTimelineAsync();
            await RefreshFaultsAsync();

            await InvokeAsync(StateHasChanged);
        });

        _hub.On<Alert>(HubEvents.AlertRaised, async alert =>
        {
            // A long outage re-sends its one alert at a higher severity: replace, never duplicate.
            _active.RemoveAll(a => a.Id == alert.Id);
            _suppressed.RemoveAll(a => a.Id == alert.Id);

            if (alert.Suppressed) _suppressed.Insert(0, alert);
            else _active.Insert(0, alert);

            Rank();
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<string>(HubEvents.AlertDismissed, async id =>
        {
            _active.RemoveAll(a => a.Id == id);
            _suppressed.RemoveAll(a => a.Id == id);
            if (_selectedAlert?.Id == id) _selectedAlert = null;
            await InvokeAsync(StateHasChanged);
        });

        _hub.Reconnecting += _ => Update("reconnecting", false);
        _hub.Reconnected += _ => Update("live", true);
        _hub.Closed += _ => Update("disconnected", false);

        try
        {
            await _hub.StartAsync();
            _connected = true;
            _connectionLabel = "live";
        }
        catch (Exception)
        {
            _connectionLabel = "push unavailable";
        }
    }

    private Task Update(string label, bool connected)
    {
        _connectionLabel = label;
        _connected = connected;
        return InvokeAsync(StateHasChanged);
    }

    private void SortAlerts(IReadOnlyList<Alert> alerts)
    {
        _active = alerts.Where(a => !a.Suppressed).ToList();
        _suppressed = alerts.Where(a => a.Suppressed).ToList();
        Rank();
    }

    /// <summary>Severity first, then recency. This ordering is the whole point of the rail.</summary>
    // Reference [21]: Wikipedia. Alarm fatigue.
    //   https://en.wikipedia.org/wiki/Alarm_fatigue
    private void Rank()
    {
        _active = _active.OrderByDescending(a => a.Severity).ThenByDescending(a => a.RaisedAt).Take(40).ToList();
        _suppressed = _suppressed.OrderByDescending(a => a.RaisedAt).Take(40).ToList();
    }

    private void RefreshMeters()
    {
        _meters = _snapshots.Where(s => s.Category == SensorCategory.PumpPower).ToList();
        _actuators = _snapshots.Where(s => s.Payload == PayloadKind.Boolean).OrderBy(s => s.DisplayName).ToList();

        if (_meters.Count >= 2)
        {
            if (!_meters.Any(s => s.Id == _aggregateA)) _aggregateA = _meters[0].Id;
            if (!_meters.Any(s => s.Id == _aggregateB)) _aggregateB = _meters[1].Id;
        }
    }

    private async Task SelectAlert(Alert alert)
    {
        _selectedAlert = alert;
        _selectedSensor = _snapshots.FirstOrDefault(s => s.Id == alert.SensorId) ?? _selectedSensor;
        await LoadAttachmentsAsync();
    }

    private async Task SelectSensor(SensorSnapshot sensor)
    {
        _selectedSensor = sensor;
        _selectedAlert = _active.Concat(_suppressed).FirstOrDefault(a => a.SensorId == sensor.Id);
        await LoadAttachmentsAsync();
    }

    private async Task LoadAttachmentsAsync()
        => _selectedAttachments = _selectedSensor is null
            ? []
            : await Gateway.GetAttachmentsAsync(_selectedSensor.Id);

    private async Task DismissAsync(Alert alert)
    {
        await Gateway.DismissAlertAsync(alert.Id);
        _active.RemoveAll(a => a.Id == alert.Id);
        _suppressed.RemoveAll(a => a.Id == alert.Id);
        _selectedAlert = null;
    }

    private async Task RestoreAsync(Alert alert)
    {
        await Gateway.RestoreAsync(alert.SensorId, alert.Kind);
        SortAlerts(await Gateway.GetAlertsAsync());
    }

    private void OnAggregateChanged(ChangeEventArgs args, bool left)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        if (left) _aggregateA = value; else _aggregateB = value;
    }

    private async Task AggregateAsync()
        => _aggregate = await Gateway.AggregateAsync(_aggregateA, _aggregateB);

    private async Task RefreshRegistryAsync() => _registry = await Gateway.GetRegistryAsync() ?? _registry;

    private async Task LookupAsync()
    {
        _registryHit = await Gateway.FindSensorAsync(_registryKey.Trim());
        _registryMissed = _registryHit is null;
        await RefreshRegistryAsync();
    }

    private async Task RefreshTimelineAsync()
    {
        // Until one is picked, or if the picked one is deleted, show a node with a level to
        // plot (an actuator's on/off trace says little), else whatever is registered.
        if (!_snapshots.Any(s => s.Id == _timelineSensor))
            _timelineSensor = (_snapshots.FirstOrDefault(s => s.Payload != PayloadKind.Boolean) ?? _snapshots.FirstOrDefault())?.Id ?? string.Empty;
        if (_timelineSensor.Length == 0) return;

        _timeline = await Gateway.GetTimelineAsync(_timelineSensor) ?? _timeline;
    }

    private async Task OnTimelineSensorChanged(ChangeEventArgs args)
    {
        _timelineSensor = args.Value?.ToString() ?? string.Empty;
        await RefreshTimelineAsync();
    }

    private async Task ScrambleAsync()
    {
        await Gateway.ScrambleTimelineAsync(_timelineSensor);
        await RefreshTimelineAsync();
    }

    private async Task RefreshFaultsAsync()
    {
        _faults = await Gateway.GetFaultsAsync() ?? _faults;
        if (!_snapshots.Any(s => s.Id == _unplugSensor)) _unplugSensor = _snapshots.FirstOrDefault()?.Id ?? string.Empty;
    }

    private async Task UnplugAsync(int seconds)
    {
        await Gateway.UnplugAsync(_unplugSensor, seconds);
        await RefreshFaultsAsync();
    }

    private async Task RefreshCommandsAsync() => _commands = await Gateway.GetCommandsAsync() ?? _commands;

    private async Task CommandAsync(SensorSnapshot device, bool state)
    {
        await Gateway.CommandDeviceAsync(device.Id, state);
        await RefreshCommandsAsync();
    }

    private async Task ShutAllValvesAsync()
    {
        await Gateway.CommandCategoryAsync(SensorCategory.IrrigationValve, false);
        await RefreshCommandsAsync();
    }

    private async Task UndoAsync()
    {
        await Gateway.UndoCommandAsync();
        await RefreshCommandsAsync();
    }

    private string OverrideLabel(string sensorId)
        => _commands is not null && _commands.Overrides.TryGetValue(sensorId, out var pinned)
            ? $"pinned {(pinned ? "on" : "off")}"
            : "auto";

    private async Task RefreshQueueAsync()
    {
        _queue = await Gateway.GetQueueAsync() ?? _queue;

        // The trail is bounded, so a critical packet scrolls out of it once the backlog
        // behind it has drained. Remember the last one, and the most it was seen to overtake.
        if (_queue?.Recent.LastOrDefault(e => e.Critical is not null) is not { } critical) return;

        var overtaken = _queue.Recent.Count(e => e.Position > critical.Position && e.Sequence < critical.Sequence);
        _overtaken = critical.Sequence == _lastCritical?.Sequence ? Math.Max(_overtaken, overtaken) : overtaken;
        _lastCritical = critical;
    }

    private async Task FloodAsync()
    {
        await Gateway.FloodQueueAsync();
        await RefreshQueueAsync();
    }

    /// <summary>Any numeric node will do: the critical packet is about its value, not which sensor sent it.</summary>
    private SensorSnapshot? CriticalTarget => _snapshots.FirstOrDefault(s => s.Payload != PayloadKind.Boolean);

    private async Task SendCriticalAsync()
    {
        if (CriticalTarget is not { } sensor) return;

        // Far outside anything the node normally reads, and a whole number so an
        // integer sensor accepts it too.
        await Gateway.PostTelemetryAsync(sensor.Id, Math.Round(Math.Abs(sensor.LatestValue) * 3 + 100));
        await RefreshQueueAsync();
    }

    private string SensorName(string id) => _snapshots.FirstOrDefault(s => s.Id == id)?.DisplayName ?? id;

    private bool Flagged(SensorSnapshot sensor)
        => sensor.IsSilent || _active.Any(a => a.SensorId == sensor.Id && a.Severity >= AlertSeverity.Warning);

    private string TileClass(SensorSnapshot sensor)
    {
        var classes = new List<string>();
        if (Flagged(sensor) && !sensor.IsSilent) classes.Add("flagged");
        if (sensor.IsSilent) classes.Add("silent");
        if (sensor.Id == _selectedSensor?.Id) classes.Add("sel");
        return string.Join(' ', classes);
    }

    private static string Reading(SensorSnapshot sensor) => sensor.Payload switch
    {
        PayloadKind.Boolean => sensor.LatestBool ? "OPEN" : "SHUT",
        PayloadKind.Integer => sensor.LatestValue.ToString("0"),
        _ => sensor.LatestValue.ToString("0.0")
    };

    private static string PayloadType(PayloadKind payload) => payload switch
    {
        PayloadKind.Float => "float",
        PayloadKind.Integer => "int",
        _ => "bool"
    };

    private static string SeverityClass(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Critical => "crit",
        AlertSeverity.Warning => "warn",
        _ => "info"
    };

    private static string Bytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024d:0.#} KB",
        _ => $"{bytes / (1024d * 1024d):0.##} MB"
    };

    private static string Ago(DateTimeOffset at)
    {
        var span = DateTimeOffset.UtcNow - at;
        return span.TotalSeconds switch
        {
            < 60 => $"{span.TotalSeconds:0}s ago",
            < 3600 => $"{span.TotalMinutes:0}m ago",
            _ => $"{span.TotalHours:0}h ago"
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
